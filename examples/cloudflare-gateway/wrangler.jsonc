{
  "name": "omnipin-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "limits": { "cpu_ms": 300000 },
  "d1_databases": [
    { "binding": "DB", "database_name": "omnipin-gateway", "database_id": "REPLACE_ME" }
  ],
  "r2_buckets": [{ "binding": "CARS", "bucket_name": "omnipin-cars" }],
  "workflows": [
    {
      "name": "omnipin-deploy",
      "binding": "DEPLOY_WORKFLOW",
      "class_name": "DeployWorkflow"
    }
  ],
  "vars": { "RPC_URL": "https://ethereum-sepolia-rpc.publicnode.com" }
}
