{
	"name": "omnipin-web-apps",
	"version": "1.0.0-rc.0",
	"author": "v1rtl <hi@v1rtl.site>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ECKeyMaker/omnipin-for-web-apps.git"
	},
	"devDependencies": {
		"@account-abstraction/contracts": "0.7.0",
		"@biomejs/biome": "^2.4.7",
		"@ipld/car": "^5.4.2",
		"@ipld/dag-pb": "^4.1.7",
		"@jsr/omnipin__foc": "^0.0.20",
		"@multiformats/murmur3": "^2.2.5",
		"@omnipin/foc": "npm:@jsr/omnipin__foc@0.0.20",
		"@openzeppelin/contracts": "5.1.0",
		"@rslib/core": "^0.23.2",
		"@size-limit/file": "^12.0.1",
		"@stauro/filebase-upload": "npm:@jsr/stauro__filebase-upload",
		"@types/node": "^26.2.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/varint": "^6.0.3",
		"esbuild": "^0.28.2",
		"fflate": "^0.8.3",
		"forge-std": "github:foundry-rs/forge-std#v1.9.7",
		"hamt-sharding": "^3.0.8",
		"interface-store": "^8.0.0",
		"jsdom": "^30.1.3",
		"miniflare": "^4.20260730.0",
		"nanotar": "^0.3.0",
		"prool": "^0.2.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"size-limit": "^12.0.1",
		"spektr": "^0.2.0",
		"tinyglobby": "^0.2.15",
		"typescript": "^7.0.2",
		"varint": "^6.0.0"
	},
	"dependencies": {
		"interface-blockstore": "^7.0.1",
		"ipfs-unixfs": "^13.0.0",
		"multiformats": "^14.0.0",
		"ox": "^0.14.8"
	},
	"bin": {
		"omnipin-web-apps": "dist/cli.js"
	},
	"description": "Deploy static sites to IPFS from any web app, with gas and storage paid from a shared public pool",
	"engineStrict": true,
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"contracts/src"
	],
	"homepage": "https://github.com/ECKeyMaker/omnipin-for-web-apps",
	"keywords": [
		"ipfs",
		"deploy",
		"ens",
		"web3",
		"cloudflare-workers",
		"erc-4337",
		"react"
	],
	"license": "MIT",
	"packageManager": "pnpm@12.11.2",
	"release": {
		"branches": [
			"main"
		]
	},
	"scripts": {
		"build": "rslib && cp src/worker/schema.sql dist/schema.sql",
		"prepublishOnly": "pnpm build && size-limit",
		"check": "biome check",
		"types": "tsc --noEmit",
		"test": "node --experimental-test-module-mocks --import ./test/register.ts --test 'test/**/*.test.ts'",
		"test:report": "mkdir -p coverage && node --experimental-test-module-mocks --import ./test/register.ts --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'test/**/*.test.ts'",
		"test:e2e": "pnpm build && node --import ./test/register.ts --test 'e2e/**/*.test.ts'",
		"check:core": "node scripts/check-core.ts",
		"test:contracts": "cd contracts && forge test",
		"prepare": "rslib && cp src/worker/schema.sql dist/schema.sql"
	},
	"size-limit": [
		{
			"path": "dist/cli.js",
			"limit": "1MB",
			"brotli": false
		},
		{
			"path": [
				"dist/*.js",
				"!dist/cli.js"
			],
			"limit": "1MB",
			"brotli": false
		}
	],
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"import": "./dist/client.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react.js"
		},
		"./worker": {
			"types": "./dist/worker/index.d.ts",
			"import": "./dist/worker.js"
		},
		"./pack.worker": "./dist/pack.worker.js",
		"./schema.sql": "./dist/schema.sql"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
